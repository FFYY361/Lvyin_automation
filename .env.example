# Never commit real values!!!

# TAFA website login used to obtain THUFootball credentials automatically
TAFA_USERNAME=
TAFA_PASSWORD=

# Only the manual website setting writes these optional fallback values.
THUFOOTBALL_OPENID=
THUFOOTBALL_SESSION_KEY=

# 浏览器登录后打开 https://www.tafa.org.cn/member/ref_db_new.php，在控制台输入：
# copy(JSON.stringify({openid: USER_OPENID, session_key: USER_SESSION_KEY}))
# 网站运行期间通过 PUT /api/settings/thufootball-credentials 更新，不要只编辑本文件。

# WeChat Official Account server credentials
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# AMap Web Service weather API key
AMAP_WEATHER_API_KEY=

# Website PostgreSQL (local development only)
WEBSITE_POSTGRES_DB=lvyin
WEBSITE_POSTGRES_USER=lvyin
WEBSITE_POSTGRES_PASSWORD=123456
WEBSITE_DATABASE_URL=postgresql+psycopg://lvyin:123456@127.0.0.1:5432/lvyin

# Website runtime
WEBSITE_ARTIFACT_ROOT=var/artifacts
WEBSITE_API_HOST=127.0.0.1
WEBSITE_API_PORT=8000
WEBSITE_LOG_LEVEL=INFO
# Required by the website; existing permanent WeChat cover material ID.
# Auto Preview CLI falls back to its bundled PNG when this is empty.
WEBSITE_DEFAULT_COVER_MEDIA_ID=

# Locally signed login cookie
WEBSITE_COOKIE_NAME=lvyin_session
WEBSITE_COOKIE_SECRET=replace-with-a-long-random-string
WEBSITE_COOKIE_SECURE=false
